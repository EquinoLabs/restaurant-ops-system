# ==============================================================================
# ROMS Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual database credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (NEON POSTGRESQL vs LOCAL POSTGRESQL)
# ------------------------------------------------------------------------------

# OPTION A: Neon Managed PostgreSQL (RECOMMENDED FOR CLOUD / PROD)
# Uncomment DATABASE_URL below and paste your connection string from the Neon Console.
# Supported formats: postgresql://..., postgres://..., or postgresql+psycopg://...
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# OPTION B: Local PostgreSQL / Docker Compose Fallback
# Used automatically if DATABASE_URL is not set above.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=roms_user
POSTGRES_PASSWORD=roms_password
POSTGRES_DB=roms_db


# ------------------------------------------------------------------------------
# 2. FASTAPI BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
PROJECT_NAME="Restaurant Operations Management System"
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:5176","http://127.0.0.1:5176"]


# ------------------------------------------------------------------------------
# 3. FRONTEND WEB APP CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1


# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 IMAGE STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Server-side only credentials (NEVER prefix with VITE_)
R2_ACCOUNT_ID=replace_with_account_id
R2_ACCESS_KEY_ID=replace_with_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_secret_access_key
R2_BUCKET_NAME=roms-public-images
R2_PUBLIC_BASE_URL=https://pub-roms-dev.r2.dev
R2_MAX_IMAGE_BYTES=5242880
