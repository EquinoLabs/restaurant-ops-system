# ==============================================================================
# ROMS Git Ignore Rules (.gitignore)
# ==============================================================================

# --- Python & Backend ---
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.build/

# --- Environment & Secret Files ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# --- Node.js & Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Operating System & IDE ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE settings
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- Database & Local Storage Files ---
*.sqlite
*.sqlite3
*.db

# --- Miscellaneous ---
\#ME/
\#private/
\#private
*.log

