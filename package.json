{
  "name": "roms-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:platform-admin": "vite apps/platform-admin --config apps/platform-admin/vite.config.ts",
    "dev:business-manager": "vite apps/business-manager --config apps/business-manager/vite.config.ts",
    "dev:customer-web": "vite apps/customer-web --config apps/customer-web/vite.config.ts",
    "build:platform-admin": "vite build apps/platform-admin --config apps/platform-admin/vite.config.ts",
    "build:business-manager": "vite build apps/business-manager --config apps/business-manager/vite.config.ts",
    "build:customer-web": "vite build apps/customer-web --config apps/customer-web/vite.config.ts",
    "build": "npm run build:platform-admin && npm run build:business-manager && npm run build:customer-web",
    "test": "vitest run",
    "test:platform-admin": "vitest run apps/platform-admin",
    "test:business-manager": "vitest run apps/business-manager",
    "test:customer-web": "vitest run apps/customer-web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vitest": "^1.3.1"
  }
}
